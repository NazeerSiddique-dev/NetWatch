# NetWatch Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env to version control

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=NetWatch
APP_VERSION=1.0.0
DEBUG=true

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (development default - zero-install)
DATABASE_URL=sqlite+aiosqlite:///./netwatch.db

# PostgreSQL (production - uncomment when ready)
# DATABASE_URL=postgresql+asyncpg://netwatch:changeme@localhost:5432/netwatch

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_STREAM_MAX_LEN=10000

# ── Network Monitoring ────────────────────────────────────────────────────────
# Default interface to monitor (auto-detect if empty)
DEFAULT_INTERFACE=enp0s31f6

# Collector mode: synthetic | pcap | auto
# synthetic: demo mode, no privileges required
# pcap: real packet capture (requires CAP_NET_RAW or root)
# auto: tries pcap, falls back to synthetic
COLLECTOR_MODE=synthetic

# Interval between metric aggregations (seconds)
METRIC_INTERVAL=1

# Flow timeout (seconds of inactivity before flow is closed)
FLOW_TIMEOUT=60

# ── Anomaly Detection ─────────────────────────────────────────────────────────
# Method: statistical | isolation_forest
ANOMALY_METHOD=statistical
ANOMALY_THRESHOLD=3.0
ANOMALY_TRAINING_WINDOW=300
ANOMALY_MIN_SAMPLES=30

# ── Alerts ────────────────────────────────────────────────────────────────────
ALERT_COOLDOWN_SECONDS=60

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Data Retention ────────────────────────────────────────────────────────────
RETENTION_RAW_FLOWS_HOURS=24
RETENTION_METRICS_1S_HOURS=24
RETENTION_METRICS_1M_DAYS=30
RETENTION_ALERTS_DAYS=90

# ── Network Lab ───────────────────────────────────────────────────────────────
LAB_DEFAULT_SUBNET=10.99.0.0/24
LAB_BRIDGE_NAME=netwatch-br0
LAB_MAX_NAMESPACES=10
LAB_TRAFFIC_MAX_RATE=100000

# ── Prometheus ────────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
